#include <WiFi.h>
#include <WebServer.h>

//VARIABLES GLOBALES
const char* AP_SSID = "ESP32-Web";
const char* AP_PASS = "12345678";
int money = 1; // DINERO visible
//INICIALIZACIONES
WebServer server(80);
extern const char INDEX_HTML[] PROGMEM;

//DECLARACIONES DE FUNCIONES
String get_tipo_planta(String ID);
String get_estado_planta(String ID);
String get_riego_planta(String ID);
String moneyFmt(int v);
void inicializar_server(void);

//DECLARACIONES DE ARRAYS Y OTROS
const char* IDMAP[10] = {"","A1","B1","C1","A2","B2","C2","A3","B3","C3"};

String moneyFmt(int v){ if(v<0) v=0; char b[8]; snprintf(b,sizeof(b),"%03d",v); return String(b); }

// ---------- HTTP handlers ----------



void setup(){
  Serial.begin(115200);
  inicializar_server();

}

void loop(){ 
  server.handleClient(); 
}


//FUNCIONES WEB SERVER
void handleCultivoInfo(){
  if(!server.hasArg("n")){
    server.send(400, "application/json; charset=utf-8", "{\"error\":\"falta parametro n\"}");
    return;
  }
  int n = server.arg("n").toInt();
  if(n < 1 || n > 9){
    server.send(400, "application/json; charset=utf-8", "{\"error\":\"n debe ser 1..9\"}");
    return;
  }

  String id = IDMAP[n];
  // Usa tus funciones para obtener los datos reales
  String tipo   = get_tipo_planta(id);
  String estado = get_estado_planta(id);
  String riego  = get_riego_planta(id);

  String json = "{\"id\":\"" + id +
                "\",\"tipo\":\"" + tipo +
                "\",\"estado\":\"" + estado +
                "\",\"riego\":\"" + riego + "\"}";
  server.send(200, "application/json; charset=utf-8", json);
}

void handleRoot(){
  String page = String(FPSTR(INDEX_HTML));   // leer desde PROGMEM
  page.replace(">001<", ">" + moneyFmt(money) + "<");
  server.send(200, "text/html; charset=utf-8", page);
}



//FUNCIONES APLICACIÓN POR CORREGIR
String get_tipo_planta(String ID){  // demo: cambia según tu clase
  if(ID=="A1") return "tomate";
  if(ID=="B1") return "tomate";
  return "alfalfa";
}
String get_estado_planta(String ID){
  if(ID=="B1") return "sana";
  return "moribunda";
}
String get_riego_planta(String ID){
  if(ID=="B1") return "seca";
  return "regada";
}


//FUNCIONES DE INICIALIZACIÓN
void inicializar_server(void){
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/cultivo_info", HTTP_GET, handleCultivoInfo);
  server.begin();
}


